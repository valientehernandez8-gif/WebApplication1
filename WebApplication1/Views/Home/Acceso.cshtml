@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Tienda de Abarrotes</title>
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Iconos Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Estilos -->
    <link href="~/Css/Estilos.css" rel="stylesheet" />
</head>
<body>
    <!-- Barra de Navegacion -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-tienda">
        <div class="container-fluid px-lg-4">
            <!-- LOGOTIPO -->
            <a class="navbar-brand d-flex align-items-center gap-2" href="@Url.Action("Acceso", "Home")">
                <i class="bi bi-basket2 logo-icono"></i>
                <span class="logo-texto">
                    Tienda de Abarrotes
                    <strong> "---" </strong>
                </span>
            </a>

            <!-- BOTÓN RESPONSIVO -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menuPrincipal"
                    aria-controls="menuPrincipal"
                    aria-expanded="false"
                    aria-label="Abrir menú">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="menuPrincipal">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-2">
                    <!-- Inicio -->
                    <li class="nav-item">
                        <a class="nav-link menu-activo" href="@Url.Action("Acceso", "Home")">
                            <i class="bi bi-house-door-fill me-1"></i> Inicio
                        </a>
                    </li>

                    <!-- Ventas -->
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Ventas", "Home")">
                            <i class="bi bi-tag me-1"></i> Ventas
                        </a>
                    </li>

                    <!-- Proveedores -->
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Proveedores", "Home")">
                            <i class="bi bi-truck me-1"></i> Proveedores
                        </a>
                    </li>
                </ul>
                <!-- USUARIO -->
                <div class="d-flex align-items-center">
                    <a href="@Url.Action("Index", "Home")" class="usuario-icono" title="Cerrar sesión" aria-label="Cerrar sesión">
                        <i class="bi bi-person-circle"></i>
                    </a>
                </div>

            </div>
        </div>
    </nav>

    <!-- Contenido p-->
    <main class="container-fluid contenido-principal px-3 px-lg-4">
        <!-- Bienvenida -->
        <section class="row align-items-center bienvenida">
            <div class="col-12 col-md-8">
                <h1 class="titulo-bienvenida">
                    ¡Bienvenido a tu tienda!
                </h1>

                <p class="subtitulo-bienvenida mb-0">
                    Administra tus productos y mantén tu inventario al día
                </p>
            </div>

            <div class="col-md-4 d-none d-md-flex justify-content-end">
                <div class="ilustracion-tienda">
                    <i class="bi bi-basket2-fill"></i>
                    <i class="bi bi-bag-heart-fill icono-decorativo"></i>
                </div>

            </div>
        </section>

        <!-- Buscador -->
        <section class="row mb-4">
            <div class="col-12 col-lg-8 col-xl-7">
                <form class="input-group buscador" id="formBusqueda" role="search">
                    <button class="btn boton-buscar" type="submit" aria-label="Buscar productos">
                        <i class="bi bi-search"></i>
                    </button>
                    <input type="search"
                           class="form-control"
                           id="q"
                           placeholder="Buscar producto por nombre..."
                           autocomplete="off"
                           aria-label="Buscar productos">
                </form>
            </div>
        </section>

        <!-- RESULTADOS DE BÚSQUEDA -->
        <section id="resultados"
                 class="resultados-busqueda mb-3"
                 aria-live="polite">
        </section>

        <!-- BOTÓN VER TODOS -->
        <div class="mt-3 mb-4">

            <button type="button"
                    class="btn btn-ver-todos"
                    id="verTodos">

                <i class="bi bi-box-seam me-2"></i>

                Ver todos los productos

            </button>

        </div>

        <!-- Tarjetas de Acciones -->
        <section class="row g-4 mb-4">
            <!-- INGRESAR PRODUCTOS -->
            <div class="col-12 col-md-4">
                <a href="@Url.Action("IngresarProductos", "Home")" class="card tarjeta-accion tarjeta-verde h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="icono-accion icono-verde">
                            <i class="bi bi-bag-plus"></i>
                        </div>

                        <div class="flex-grow-1">
                            <h5 class="titulo-tarjeta">
                                Ingresar productos
                            </h5>
                            <p class="descripcion-tarjeta mb-0">
                                Registra nueva mercancía
                            </p>
                        </div>
                        <i class="bi bi-chevron-right flecha-tarjeta"></i>
                    </div>
                </a>
            </div>

            <!-- VER PRODUCTOS -->
            <div class="col-12 col-md-4">
                <a href="@Url.Action("VerProductos", "Home")" class="card tarjeta-accion tarjeta-amarilla h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="icono-accion icono-amarillo">
                            <i class="bi bi-box-seam"></i>
                        </div>

                        <div class="flex-grow-1">
                            <h5 class="titulo-tarjeta">
                                Ver todos los productos
                            </h5>
                            <p class="descripcion-tarjeta mb-0">
                                Consulta precios y existencias
                            </p>
                        </div>

                        <i class="bi bi-chevron-right flecha-tarjeta"></i>
                    </div>
                </a>
            </div>

            <!-- ELIMINAR PRODUCTOS -->
            <div class="col-12 col-md-4">
                <a href="@Url.Action("EliminarProductos", "Home")" class="card tarjeta-accion tarjeta-verde h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="icono-accion icono-verde">
                            <i class="bi bi-trash3"></i>
                        </div>

                        <div class="flex-grow-1">
                            <h5 class="titulo-tarjeta">
                                Eliminar productos
                            </h5>
                            <p class="descripcion-tarjeta mb-0">
                                Gestiona productos del inventario
                            </p>
                        </div>

                        <i class="bi bi-chevron-right flecha-tarjeta"></i>

                    </div>
                </a>
            </div>

        </section>
    </main>

    <script>
        const API = 'buscar-productos';          // URL del Servlet
        const form = document.getElementById('formBusqueda');
        const input = document.getElementById('q');
        const contenedor = document.getElementById('resultados');
        let temporizador;

        // Evita inyección de HTML al pintar datos de la base de datos
        const esc = s => String(s ?? '').replace(/[&<>"']/g,
            c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

        async function buscar(texto) {
            contenedor.innerHTML = '<p class="mensaje">Buscando…</p>';
            try {
                const resp = await fetch(`${API}?q=${encodeURIComponent(texto)}`);
                if (!resp.ok) throw new Error(resp.status);
                pintar(await resp.json());
            } catch (e) {
                contenedor.innerHTML = '<p class="mensaje">No se pudo realizar la búsqueda. Inténtalo de nuevo.</p>';
            }
        }

        function pintar(productos) {
            if (!productos.length) {
                contenedor.innerHTML = '<p class="mensaje">No se encontraron productos.</p>';
                return;
            }
            contenedor.innerHTML = `
          <table>
            <thead><tr><th>Código</th><th>Nombre</th><th>Precio</th><th>Stock</th></tr></thead>
            <tbody>${productos.map(p => `
              <tr><td>${esc(p.codigo)}</td><td>${esc(p.nombre)}</td>
                  <td>$${Number(p.precio).toFixed(2)}</td><td>${esc(p.stock)}</td></tr>`).join('')}
            </tbody>
          </table>`;
        }

        // Buscar al enviar el formulario (Enter o clic en la lupa)
        form.addEventListener('submit', e => { e.preventDefault(); buscar(input.value.trim()); });

        // Buscar mientras se escribe (espera 300 ms para no saturar el servidor)
        input.addEventListener('input', () => {
            clearTimeout(temporizador);
            const texto = input.value.trim();
            if (!texto) { contenedor.innerHTML = ''; return; }
            temporizador = setTimeout(() => buscar(texto), 300);
        });

        document.getElementById('verTodos').addEventListener('click', () => { input.value = ''; buscar(''); });
    </script>

</body>
</html>