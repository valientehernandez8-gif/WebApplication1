
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Inicio de Sesión</title>

    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
</head>
<body>

    <div class="card-title" style="text-align:center">
        <h1>Inicio de Sesión</h1>
    </div>

    <div class="container" style="text-align:center; width:400px; margin-top:50px">
        <form action='@Url.Action("Acceso","Home")' , method="post">
            <label>Usuario</label>
            <input class="form-control" type="text" id="txtUsuario" name="txtUsuario" />
            <a href="@Url.Action("RecuperarUsuario", "Home")">¿Olvidaste tu usuario?</a>
            <br /><br />
            <label>Contraseña</label>
            <input class="form-control" type="password" id="txtContrasena" name="txtContrasena" />
            <a href="@Url.Action("RecuperarContrasena", "Home")">¿Olvidaste tu contraseña?</a>
            <br /><br />
            <input class="form-control btn btn-success" type="submit" id="btnEnter" name="btnEnter" value="Entrar" />
        </form>
    </div>
</body>
</html>
